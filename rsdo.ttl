rsdo:ConventionalSpeedRailway rdf:type owl:Class ;
                              rdfs:subClassOf rsdo:Railway .


###  https://w3id.org/rsdo#CrownArchElement
rsdo:CrownArchElement rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:TunnelBodyElement .


###  https://w3id.org/rsdo#CrownTopCenterAngle
rsdo:CrownTopCenterAngle rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:Angle .


###  https://w3id.org/rsdo#CrownTopRadius
rsdo:CrownTopRadius rdf:type owl:Class ;
                    rdfs:subClassOf rsdo:Radius .


###  https://w3id.org/rsdo#CrownTopToTrackSurfaceDistance
rsdo:CrownTopToTrackSurfaceDistance rdf:type owl:Class ;
                                    rdfs:subClassOf rsdo:Distance .


###  https://w3id.org/rsdo#CrownWaistCenterAngle
rsdo:CrownWaistCenterAngle rdf:type owl:Class ;
                           rdfs:subClassOf rsdo:Angle .


###  https://w3id.org/rsdo#CrownWaistRadius
rsdo:CrownWaistRadius rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:Radius .


###  https://w3id.org/rsdo#CurveRadius
rsdo:CurveRadius rdf:type owl:Class ;
                 rdfs:subClassOf rsdo:Radius .


