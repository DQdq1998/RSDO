@prefix : <https://w3id.org/rsdo#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix bot: <https://w3id.org/bot#> .
@prefix bpo: <https://w3id.org/bpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsdo: <https://w3id.org/rsdo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .
@base <https://w3id.org/rsdo#> .

<https://w3id.org/rsdo> rdf:type owl:Ontology ;
                         owl:versionIRI <https://w3id.org/rsdo/1.0> ;
                         owl:imports <https://w3id.org/bpo/1-2> ;
                         dc:created "2025-06-10" ;
                         dc:creator "Qiang Du" ;
                         dc:description "The Railway Survey and Design Ontology (RSDO) is a modular ontology for railway survey and design information modelling. It is organised in five modules - spatial, complementary semantic, component, attribute and unit - and reuses the Building Topology Ontology (BOT) and the Building Product Ontology (BPO)."@en ;
                         dc:license "https://creativecommons.org/licenses/by/4.0/" ;
                         dc:modified "2026-11-03" ;
                         dc:title "Railway Survey and Design Ontology (RSDO)"@en ,
                                  "铁路勘测设计本体 (RSDO)"@zh ;
                         vann:preferredNamespacePrefix "rsdo" ;
                         vann:preferredNamespaceUri "https://w3id.org/rsdo#" ;
                         rdfs:seeAlso "https://w3id.org/rsdo" ;
                         owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dc:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dc:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dc:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://qudt.org/schema/qudt/unit
qudt:unit rdf:type owl:ObjectProperty .


###  https://w3id.org/bpo#hasAttribute
bpo:hasAttribute rdf:type owl:ObjectProperty .


###  https://w3id.org/rsdo#RailwaySemanticBelongsTo
rsdo:RailwaySemanticBelongsTo rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf rsdo:semanticBelongsTo ;
                              owl:inverseOf rsdo:hasRailwaySemantic .


###  https://w3id.org/rsdo#hasProfessionSemantic
rsdo:hasProfessionSemantic rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf rsdo:hasSemantic ;
                           owl:inverseOf rsdo:professionSemanticBelongsTo ;
                           rdfs:domain rsdo:ProfessionSpace .


###  https://w3id.org/rsdo#hasProjectSemantic
rsdo:hasProjectSemantic rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf rsdo:hasSemantic ;
                        owl:inverseOf rsdo:projectSemanticBelongsTo ;
                        rdfs:domain rsdo:ProjectSpace .


###  https://w3id.org/rsdo#hasRailwaySemantic
rsdo:hasRailwaySemantic rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf rsdo:hasSemantic .


###  https://w3id.org/rsdo#hasSemantic
rsdo:hasSemantic rdf:type owl:ObjectProperty ;
                 owl:inverseOf rsdo:semanticBelongsTo ;
                 rdfs:domain bot:Zone .


###  https://w3id.org/rsdo#hasUnit
rsdo:hasUnit rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf qudt:unit ;
             rdfs:domain rsdo:Quantity ;
             rdfs:range qudt:Unit ;
             rdfs:comment "Attaches a quantity attribute to its unit of measure; a sub-property of qudt:unit, ranging over QUDT unit individuals such as unit:MPA, unit:M, unit:MilliM or unit:DEG."@en ,
                          "将量值型属性与其计量单位关联，是 qudt:unit 的子属性；单位个体来自 QUDT。"@zh ;
             rdfs:label "has unit of measure"@en .


###  https://w3id.org/rsdo#professionSemanticBelongsTo
rsdo:professionSemanticBelongsTo rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf rsdo:semanticBelongsTo .


###  https://w3id.org/rsdo#projectSemanticBelongsTo
rsdo:projectSemanticBelongsTo rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf rsdo:semanticBelongsTo .


###  https://w3id.org/rsdo#semanticBelongsTo
rsdo:semanticBelongsTo rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/rsdo#hasValue
rsdo:hasValue rdf:type owl:DatatypeProperty ;
              rdfs:domain bpo:Attribute .


###  https://w3id.org/rsdo#hasXCoordinate
rsdo:hasXCoordinate rdf:type owl:DatatypeProperty .


###  https://w3id.org/rsdo#hasYCoordinate
rsdo:hasYCoordinate rdf:type owl:DatatypeProperty .


###  https://w3id.org/rsdo#hasZCoordinate
rsdo:hasZCoordinate rdf:type owl:DatatypeProperty .


###  https://w3id.org/rsdo#isInScenicAreaOrTown
rsdo:isInScenicAreaOrTown rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Quantity
qudt:Quantity rdf:type owl:Class .


###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class .


###  https://w3id.org/bot#Building
bot:Building rdf:type owl:Class .


###  https://w3id.org/bot#Site
bot:Site rdf:type owl:Class .


###  https://w3id.org/bot#Space
bot:Space rdf:type owl:Class .


###  https://w3id.org/bot#Storey
bot:Storey rdf:type owl:Class .


###  https://w3id.org/bot#Zone
bot:Zone rdf:type owl:Class .


###  https://w3id.org/bpo#Attribute
bpo:Attribute rdf:type owl:Class .


###  https://w3id.org/bpo#Element
bpo:Element rdf:type owl:Class .


###  https://w3id.org/bpo#RangedAttribute
bpo:RangedAttribute rdf:type owl:Class .


###  https://w3id.org/rsdo#AA
rsdo:AA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#AB
rsdo:AB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#AbstractElement
rsdo:AbstractElement rdf:type owl:Class ;
                     rdfs:subClassOf bpo:Element ;
                     owl:disjointWith rsdo:SolidElement .


###  https://w3id.org/rsdo#Angle
rsdo:Angle rdf:type owl:Class ;
           rdfs:subClassOf rsdo:GeometricAttribute .


###  https://w3id.org/rsdo#Area
rsdo:Area rdf:type owl:Class ;
          rdfs:subClassOf rsdo:GeometricAttribute .


###  https://w3id.org/rsdo#BA
rsdo:BA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#BB
rsdo:BB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#BallastedTrack
rsdo:BallastedTrack rdf:type owl:Class ;
                    rdfs:subClassOf rsdo:Track ;
                    owl:disjointWith rsdo:BallastlessTrack ;
                    rdfs:comment "有无砟道床的是无砟轨道" .


###  https://w3id.org/rsdo#BallastlessTrack
rsdo:BallastlessTrack rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:Track ;
                      rdfs:comment "有碎石道床的是有砟轨道" .


###  https://w3id.org/rsdo#BeamBottomToBearingStoneTopHeight
rsdo:BeamBottomToBearingStoneTopHeight rdf:type owl:Class ;
                                       rdfs:subClassOf rsdo:Height .


###  https://w3id.org/rsdo#BeamBottomToPierTopHeight
rsdo:BeamBottomToPierTopHeight rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:Height .


###  https://w3id.org/rsdo#BeamJointWidth
rsdo:BeamJointWidth rdf:type owl:Class ;
                    rdfs:subClassOf rsdo:Width .


###  https://w3id.org/rsdo#BearingQuantity
rsdo:BearingQuantity rdf:type owl:Class ;
                     rdfs:subClassOf rsdo:Quantity .


###  https://w3id.org/rsdo#BearingStoneCalculatedHeight
rsdo:BearingStoneCalculatedHeight rdf:type owl:Class ;
                                  rdfs:subClassOf rsdo:Height .


###  https://w3id.org/rsdo#BearingToJointCenterlineDistance
rsdo:BearingToJointCenterlineDistance rdf:type owl:Class ;
                                      rdfs:subClassOf rsdo:Distance .


###  https://w3id.org/rsdo#Blocky
rsdo:Blocky rdf:type owl:Class ;
            rdfs:subClassOf rsdo:RockStructuralShapeAttribute .


###  https://w3id.org/rsdo#BlockyStructure
rsdo:BlockyStructure rdf:type owl:Class ;
                     rdfs:subClassOf rsdo:RockStructureTypeAttribute .


###  https://w3id.org/rsdo#BottomAndTrackFoundationLeftIntersection
rsdo:BottomAndTrackFoundationLeftIntersection rdf:type owl:Class ;
                                              rdfs:subClassOf rsdo:ControlPointAttribute .


###  https://w3id.org/rsdo#BottomAndTrackFoundationRightIntersection
rsdo:BottomAndTrackFoundationRightIntersection rdf:type owl:Class ;
                                               rdfs:subClassOf rsdo:ControlPointAttribute .


###  https://w3id.org/rsdo#Bridge
rsdo:Bridge rdf:type owl:Class ;
            rdfs:subClassOf rsdo:ProfessionDesign .


###  https://w3id.org/rsdo#BridgeCrossSectionElement
rsdo:BridgeCrossSectionElement rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:AbstractElement .


###  https://w3id.org/rsdo#CA
rsdo:CA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#CB
rsdo:CB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#CRTSⅠDoubleBlockBallastlessTrack
rsdo:CRTSⅠDoubleBlockBallastlessTrack rdf:type owl:Class ;
                                      rdfs:subClassOf rsdo:BallastlessTrack .


###  https://w3id.org/rsdo#CRTSⅠSlabBallastlessTrack
rsdo:CRTSⅠSlabBallastlessTrack rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:BallastlessTrack .


###  https://w3id.org/rsdo#CRTSⅢSlabBallastlessTrack
rsdo:CRTSⅢSlabBallastlessTrack rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:BallastlessTrack .


###  https://w3id.org/rsdo#Capacity
rsdo:Capacity rdf:type owl:Class ;
              rdfs:subClassOf rsdo:FunctionalAttribute .


###  https://w3id.org/rsdo#ChemicalAttribute
rsdo:ChemicalAttribute rdf:type owl:Class ;
                       rdfs:subClassOf rsdo:SharedAttribute .


###  https://w3id.org/rsdo#Columnar
rsdo:Columnar rdf:type owl:Class ;
              rdfs:subClassOf rsdo:RockStructuralShapeAttribute .


