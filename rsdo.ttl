#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( bot:Building
                bot:Site
                bot:Space
                bot:Storey
                rsdo:ProfessionSpace
                rsdo:ProjectSpace
                rsdo:RailwaySpace
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( rsdo:Angle
                rsdo:Area
                rsdo:Depth
                rsdo:Distance
                rsdo:Elevation
                rsdo:Height
                rsdo:Length
                rsdo:Radius
                rsdo:Thickness
                rsdo:Volume
                rsdo:Width
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( rsdo:BeamBottomToBearingStoneTopHeight
                rsdo:BeamBottomToPierTopHeight
                rsdo:BearingStoneCalculatedHeight
                rsdo:InitialTotalHeightOfBridgePier
                rsdo:InnerContourHeight
                rsdo:LargeMileBearingStoneHeight
                rsdo:PierHeight
                rsdo:SmallMileBearingStoneHeight
                rsdo:SubgradeBoxGirderSectionHeight
                rsdo:TrackHeight
              )
] .


