rsdo:CurvedTangentTunnelPortal rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:TunnelPortal .


###  https://w3id.org/rsdo#CutAndCoverStructureElement
rsdo:CutAndCoverStructureElement rdf:type owl:Class ;
                                 rdfs:subClassOf rsdo:TunnelBodyElement .


###  https://w3id.org/rsdo#DA
rsdo:DA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#DB
rsdo:DB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#DebrisLike
rsdo:DebrisLike rdf:type owl:Class ;
                rdfs:subClassOf rsdo:RockStructuralShapeAttribute .


###  https://w3id.org/rsdo#Dense
rsdo:Dense rdf:type owl:Class ;
           rdfs:subClassOf rsdo:SoilCompactionDegreeAttribute .


###  https://w3id.org/rsdo#Density
rsdo:Density rdf:type owl:Class ;
             rdfs:subClassOf rsdo:PhysicalAttribute .


###  https://w3id.org/rsdo#Depth
rsdo:Depth rdf:type owl:Class ;
           rdfs:subClassOf rsdo:GeometricAttribute .


###  https://w3id.org/rsdo#DesignTrackElevation
rsdo:DesignTrackElevation rdf:type owl:Class ;
                          rdfs:subClassOf rsdo:Elevation .


###  https://w3id.org/rsdo#Diesel
rsdo:Diesel rdf:type owl:Class ;
            rdfs:subClassOf rsdo:RailwayLineTractionTypeAttribute ;
            owl:disjointWith rsdo:Electric .


###  https://w3id.org/rsdo#Distance
rsdo:Distance rdf:type owl:Class ;
              rdfs:subClassOf rsdo:GeometricAttribute .


###  https://w3id.org/rsdo#Duststorm
rsdo:Duststorm rdf:type owl:Class ;
               rdfs:subClassOf rsdo:ProjectSurvey .


###  https://w3id.org/rsdo#DuststormElement
rsdo:DuststormElement rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:GeologicalDisasterElement .


###  https://w3id.org/rsdo#EA
rsdo:EA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#EB
rsdo:EB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#Earthquake
rsdo:Earthquake rdf:type owl:Class ;
                rdfs:subClassOf rsdo:ProjectSurvey .


###  https://w3id.org/rsdo#EarthquakeElement
rsdo:EarthquakeElement rdf:type owl:Class ;
                       rdfs:subClassOf rsdo:GeologicalDisasterElement .


###  https://w3id.org/rsdo#EavesCutTunnelPortal
rsdo:EavesCutTunnelPortal rdf:type owl:Class ;
                          rdfs:subClassOf rsdo:TunnelPortal .


###  https://w3id.org/rsdo#Efficiency
rsdo:Efficiency rdf:type owl:Class ;
                rdfs:subClassOf rsdo:FunctionalAttribute .


###  https://w3id.org/rsdo#Elasticity
rsdo:Elasticity rdf:type owl:Class ;
                rdfs:subClassOf rsdo:MaterialAttribute .


###  https://w3id.org/rsdo#Electric
rsdo:Electric rdf:type owl:Class ;
              rdfs:subClassOf rsdo:RailwayLineTractionTypeAttribute .


###  https://w3id.org/rsdo#Elevation
rsdo:Elevation rdf:type owl:Class ;
               rdfs:subClassOf rsdo:GeometricAttribute .


###  https://w3id.org/rsdo#EndWallTunnelPortal
rsdo:EndWallTunnelPortal rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:TunnelPortal .


###  https://w3id.org/rsdo#ExtraThickLayer
rsdo:ExtraThickLayer rdf:type owl:Class ;
                     rdfs:subClassOf rsdo:RockLayerThicknessAttribute .


###  https://w3id.org/rsdo#ExtremelyFragmented
rsdo:ExtremelyFragmented rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:RockIntegrityDegreeAttribute .


###  https://w3id.org/rsdo#ExtremelyPoor
rsdo:ExtremelyPoor rdf:type owl:Class ;
                   rdfs:subClassOf rsdo:RockQualityAttribute .


###  https://w3id.org/rsdo#ExtremelySoftRock
rsdo:ExtremelySoftRock rdf:type owl:Class ;
                       rdfs:subClassOf rsdo:RockHardnessDegreeAttribute .


###  https://w3id.org/rsdo#FA
rsdo:FA rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#FB
rsdo:FB rdf:type owl:Class ;
        rdfs:subClassOf rsdo:LiningCrossSectionElement .


###  https://w3id.org/rsdo#FlowRate
rsdo:FlowRate rdf:type owl:Class ;
              rdfs:subClassOf rsdo:FunctionalAttribute .


###  https://w3id.org/rsdo#FlowablePlastic
rsdo:FlowablePlastic rdf:type owl:Class ;
                     rdfs:subClassOf rsdo:SoilStateAttribute .


###  https://w3id.org/rsdo#FracturedStructure
rsdo:FracturedStructure rdf:type owl:Class ;
                        rdfs:subClassOf rsdo:RockStructureTypeAttribute .


###  https://w3id.org/rsdo#Fragmented
rsdo:Fragmented rdf:type owl:Class ;
                rdfs:subClassOf rsdo:RockIntegrityDegreeAttribute .


###  https://w3id.org/rsdo#FragmentedBlocky
rsdo:FragmentedBlocky rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:RockStructuralShapeAttribute .


###  https://w3id.org/rsdo#FreightRailway
rsdo:FreightRailway rdf:type owl:Class ;
                    rdfs:subClassOf rsdo:Railway .


###  https://w3id.org/rsdo#FreightTransport
rsdo:FreightTransport rdf:type owl:Class ;
                      rdfs:subClassOf rsdo:RailwayLineUsageAndFunctionAttribute .


###  https://w3id.org/rsdo#FrostHeaving
rsdo:FrostHeaving rdf:type owl:Class ;
                  rdfs:subClassOf rsdo:ProjectSurvey .


###  https://w3id.org/rsdo#FrostHeavingElement
rsdo:FrostHeavingElement rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:GeologicalDisasterElement .


###  https://w3id.org/rsdo#FunctionalAttribute
rsdo:FunctionalAttribute rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:SharedAttribute .


###  https://w3id.org/rsdo#GeologicalAttribute
rsdo:GeologicalAttribute rdf:type owl:Class ;
                         rdfs:subClassOf rsdo:ProfessionAttribute .


###  https://w3id.org/rsdo#GeologicalDisasterElement
rsdo:GeologicalDisasterElement rdf:type owl:Class ;
                               rdfs:subClassOf rsdo:AbstractElement .


###  https://w3id.org/rsdo#Geology
rsdo:Geology rdf:type owl:Class ;
             rdfs:subClassOf rsdo:ProfessionSurvey .


###  https://w3id.org/rsdo#GeologyElement
rsdo:GeologyElement rdf:type owl:Class ;
                    rdfs:subClassOf rsdo:SolidElement .


###  https://w3id.org/rsdo#GeometricAttribute
rsdo:GeometricAttribute rdf:type owl:Class ;
                        rdfs:subClassOf rsdo:SharedAttribute .


###  https://w3id.org/rsdo#GiantBlocky
rsdo:GiantBlocky rdf:type owl:Class ;
                 rdfs:subClassOf rsdo:RockStructuralShapeAttribute .


###  https://w3id.org/rsdo#Good
rsdo:Good rdf:type owl:Class ;
          rdfs:subClassOf rsdo:RockQualityAttribute .


###  https://w3id.org/rsdo#GradeⅠRock
rsdo:GradeⅠRock rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( rsdo:RockElement
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty bpo:hasAttribute ;
                                                             owl:someValuesFrom rsdo:Complete
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty bpo:hasAttribute ;
                                                             owl:someValuesFrom rsdo:HardRock
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf rsdo:RockElement .


###  https://w3id.org/rsdo#GradeⅡRock
rsdo:GradeⅡRock rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:unionOf ( [ owl:intersectionOf ( rsdo:RockElement
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:Complete
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:RelativelyHardRock
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                                                    [ owl:intersectionOf ( rsdo:RockElement
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:HardRock
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:RelativelyComplete
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                                                  )
                                    ] ;
                rdfs:subClassOf rsdo:RockElement .


###  https://w3id.org/rsdo#GradeⅢRock
rsdo:GradeⅢRock rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:unionOf ( [ owl:intersectionOf ( rsdo:RockElement
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:Complete
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:RelativelySoftRock
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                                                    [ owl:intersectionOf ( rsdo:RockElement
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:HardRock
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:RelativelyFragmented
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                                                    [ owl:intersectionOf ( rsdo:RockElement
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty bpo:hasAttribute ;
                                                                             owl:someValuesFrom rsdo:RelativelyComplete
