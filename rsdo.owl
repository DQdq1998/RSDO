        <Literal>rsdo</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="vann:preferredNamespaceUri"/>
        <Literal>https://w3id.org/rsdo#</Literal>
    </Annotation>
    <Annotation>
