    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:created"/>
        <Literal>2025-06-10</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <Literal>Qiang Du</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <Literal xml:lang="en">The Railway Survey and Design Ontology (RSDO) is a modular ontology for railway survey and design information modelling. It is organised in five modules - spatial, complementary semantic, component, attribute and unit - and reuses the Building Topology Ontology (BOT) and the Building Product Ontology (BPO).</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:license"/>
        <Literal>https://creativecommons.org/licenses/by/4.0/</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:modified"/>
        <Literal>2026-11-03</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:title"/>
        <Literal xml:lang="en">Railway Survey and Design Ontology (RSDO)</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:title"/>
        <Literal xml:lang="zh">铁路勘测设计本体 (RSDO)</Literal>
    </Annotation>
    <Annotation>
