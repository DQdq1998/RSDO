############################
#   Object Properties
############################

# Object Property: <https://w3id.org/rsdo#RailwaySemanticBelongsTo> (<https://w3id.org/rsdo#RailwaySemanticBelongsTo>)

SubObjectPropertyOf(rsdo:RailwaySemanticBelongsTo rsdo:semanticBelongsTo)
InverseObjectProperties(rsdo:RailwaySemanticBelongsTo rsdo:hasRailwaySemantic)

# Object Property: <https://w3id.org/rsdo#hasProfessionSemantic> (<https://w3id.org/rsdo#hasProfessionSemantic>)

SubObjectPropertyOf(rsdo:hasProfessionSemantic rsdo:hasSemantic)
InverseObjectProperties(rsdo:hasProfessionSemantic rsdo:professionSemanticBelongsTo)
ObjectPropertyDomain(rsdo:hasProfessionSemantic rsdo:ProfessionSpace)

# Object Property: <https://w3id.org/rsdo#hasProjectSemantic> (<https://w3id.org/rsdo#hasProjectSemantic>)

SubObjectPropertyOf(rsdo:hasProjectSemantic rsdo:hasSemantic)
InverseObjectProperties(rsdo:hasProjectSemantic rsdo:projectSemanticBelongsTo)
ObjectPropertyDomain(rsdo:hasProjectSemantic rsdo:ProjectSpace)

# Object Property: <https://w3id.org/rsdo#hasRailwaySemantic> (<https://w3id.org/rsdo#hasRailwaySemantic>)

SubObjectPropertyOf(rsdo:hasRailwaySemantic rsdo:hasSemantic)

# Object Property: <https://w3id.org/rsdo#hasSemantic> (<https://w3id.org/rsdo#hasSemantic>)

InverseObjectProperties(rsdo:hasSemantic rsdo:semanticBelongsTo)
ObjectPropertyDomain(rsdo:hasSemantic bot:Zone)

# Object Property: <https://w3id.org/rsdo#hasUnit> (has unit of measure)

AnnotationAssertion(rdfs:comment rsdo:hasUnit "Attaches a quantity attribute to its unit of measure; a sub-property of qudt:unit, ranging over QUDT unit individuals such as unit:MPA, unit:M, unit:MilliM or unit:DEG."@en)
AnnotationAssertion(rdfs:comment rsdo:hasUnit "将量值型属性与其计量单位关联，是 qudt:unit 的子属性；单位个体来自 QUDT。"@zh)
AnnotationAssertion(rdfs:label rsdo:hasUnit "has unit of measure"@en)
SubObjectPropertyOf(rsdo:hasUnit qudt:unit)
ObjectPropertyDomain(rsdo:hasUnit rsdo:Quantity)
ObjectPropertyRange(rsdo:hasUnit qudt:Unit)

# Object Property: <https://w3id.org/rsdo#professionSemanticBelongsTo> (<https://w3id.org/rsdo#professionSemanticBelongsTo>)

SubObjectPropertyOf(rsdo:professionSemanticBelongsTo rsdo:semanticBelongsTo)

# Object Property: <https://w3id.org/rsdo#projectSemanticBelongsTo> (<https://w3id.org/rsdo#projectSemanticBelongsTo>)

SubObjectPropertyOf(rsdo:projectSemanticBelongsTo rsdo:semanticBelongsTo)


############################
#   Data Properties
############################

# Data Property: <https://w3id.org/rsdo#hasValue> (<https://w3id.org/rsdo#hasValue>)

DataPropertyDomain(rsdo:hasValue bpo:Attribute)

# Data Property: <https://w3id.org/rsdo#isInScenicAreaOrTown> (<https://w3id.org/rsdo#isInScenicAreaOrTown>)

SubDataPropertyOf(rsdo:isInScenicAreaOrTown owl:topDataProperty)
DataPropertyRange(rsdo:isInScenicAreaOrTown xsd:boolean)



