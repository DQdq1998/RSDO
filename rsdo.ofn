Import(<https://w3id.org/bpo/1-2>)
Annotation(dc:created "2025-06-10")
Annotation(dc:creator "Qiang Du")
Annotation(dc:description "The Railway Survey and Design Ontology (RSDO) is a modular ontology for railway survey and design information modelling. It is organised in five modules - spatial, complementary semantic, component, attribute and unit - and reuses the Building Topology Ontology (BOT) and the Building Product Ontology (BPO)."@en)
Annotation(dc:license "https://creativecommons.org/licenses/by/4.0/")
Annotation(dc:modified "2026-11-03")
Annotation(dc:title "Railway Survey and Design Ontology (RSDO)"@en)
Annotation(dc:title "铁路勘测设计本体 (RSDO)"@zh)
Annotation(vann:preferredNamespacePrefix "rsdo")
Annotation(vann:preferredNamespaceUri "https://w3id.org/rsdo#")
Annotation(rdfs:seeAlso "https://w3id.org/rsdo")
Annotation(owl:versionInfo "1.0")

