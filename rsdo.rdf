    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CrownTopRadius -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CrownTopRadius">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Radius"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CrownTopToTrackSurfaceDistance -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CrownTopToTrackSurfaceDistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Distance"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CrownWaistCenterAngle -->


