    </owl:Class>
    


    <!-- https://w3id.org/rsdo#DesignTrackElevation -->


    <owl:Class rdf:about="https://w3id.org/rsdo#DesignTrackElevation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Elevation"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Diesel -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Diesel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RailwayLineTractionTypeAttribute"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rsdo#Electric"/>
