<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/rsdo#"
     xml:base="https://w3id.org/rsdo"
     xmlns:dc="http://purl.org/dc/terms/"
     xmlns:bot="https://w3id.org/bot#"
     xmlns:bpo="https://w3id.org/bpo#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rsdo="https://w3id.org/rsdo#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/rsdo">
        <owl:versionIRI rdf:resource="https://w3id.org/rsdo/1.0"/>
        <owl:imports rdf:resource="https://w3id.org/bpo/1-2"/>
        <dc:created>2025-06-10</dc:created>
        <dc:creator>Qiang Du</dc:creator>
        <dc:description xml:lang="en">The Railway Survey and Design Ontology (RSDO) is a modular ontology for railway survey and design information modelling. It is organised in five modules - spatial, complementary semantic, component, attribute and unit - and reuses the Building Topology Ontology (BOT) and the Building Product Ontology (BPO).</dc:description>
        <dc:license>https://creativecommons.org/licenses/by/4.0/</dc:license>
        <dc:modified>2026-11-03</dc:modified>
        <dc:title xml:lang="en">Railway Survey and Design Ontology (RSDO)</dc:title>
        <dc:title xml:lang="zh">铁路勘测设计本体 (RSDO)</dc:title>
        <vann:preferredNamespacePrefix>rsdo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/rsdo#</vann:preferredNamespaceUri>
        <rdfs:seeAlso>https://w3id.org/rsdo</rdfs:seeAlso>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/unit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unit"/>
    


    <!-- https://w3id.org/bpo#hasAttribute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bpo#hasAttribute"/>
    


    <!-- https://w3id.org/rsdo#RailwaySemanticBelongsTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#RailwaySemanticBelongsTo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#semanticBelongsTo"/>
        <owl:inverseOf rdf:resource="https://w3id.org/rsdo#hasRailwaySemantic"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#hasProfessionSemantic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#hasProfessionSemantic">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#hasSemantic"/>
        <owl:inverseOf rdf:resource="https://w3id.org/rsdo#professionSemanticBelongsTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/rsdo#ProfessionSpace"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#hasProjectSemantic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#hasProjectSemantic">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#hasSemantic"/>
        <owl:inverseOf rdf:resource="https://w3id.org/rsdo#projectSemanticBelongsTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/rsdo#ProjectSpace"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#hasRailwaySemantic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#hasRailwaySemantic">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#hasSemantic"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#hasSemantic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#hasSemantic">
        <owl:inverseOf rdf:resource="https://w3id.org/rsdo#semanticBelongsTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#hasUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#hasUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/unit"/>
        <rdfs:domain rdf:resource="https://w3id.org/rsdo#Quantity"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:comment xml:lang="en">Attaches a quantity attribute to its unit of measure; a sub-property of qudt:unit, ranging over QUDT unit individuals such as unit:MPA, unit:M, unit:MilliM or unit:DEG.</rdfs:comment>
        <rdfs:comment xml:lang="zh">将量值型属性与其计量单位关联，是 qudt:unit 的子属性；单位个体来自 QUDT。</rdfs:comment>
        <rdfs:label xml:lang="en">has unit of measure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#professionSemanticBelongsTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#professionSemanticBelongsTo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#semanticBelongsTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#projectSemanticBelongsTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#projectSemanticBelongsTo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rsdo#semanticBelongsTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rsdo#semanticBelongsTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rsdo#semanticBelongsTo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/rsdo#hasValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rsdo#hasValue">
        <rdfs:domain rdf:resource="https://w3id.org/bpo#Attribute"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rsdo#hasXCoordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rsdo#hasXCoordinate"/>
    


    <!-- https://w3id.org/rsdo#hasYCoordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rsdo#hasYCoordinate"/>
    


    <!-- https://w3id.org/rsdo#hasZCoordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rsdo#hasZCoordinate"/>
    


    <!-- https://w3id.org/rsdo#isInScenicAreaOrTown -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rsdo#isInScenicAreaOrTown">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/Quantity -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Quantity"/>
    


    <!-- http://qudt.org/schema/qudt/Unit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit"/>
    


    <!-- https://w3id.org/bot#Building -->


    <owl:Class rdf:about="https://w3id.org/bot#Building"/>
    


    <!-- https://w3id.org/bot#Site -->


    <owl:Class rdf:about="https://w3id.org/bot#Site"/>
    


    <!-- https://w3id.org/bot#Space -->


    <owl:Class rdf:about="https://w3id.org/bot#Space"/>
    


    <!-- https://w3id.org/bot#Storey -->


    <owl:Class rdf:about="https://w3id.org/bot#Storey"/>
    


    <!-- https://w3id.org/bot#Zone -->


    <owl:Class rdf:about="https://w3id.org/bot#Zone"/>
    


    <!-- https://w3id.org/bpo#Attribute -->


    <owl:Class rdf:about="https://w3id.org/bpo#Attribute"/>
    


    <!-- https://w3id.org/bpo#Element -->


    <owl:Class rdf:about="https://w3id.org/bpo#Element"/>
    


    <!-- https://w3id.org/bpo#RangedAttribute -->


    <owl:Class rdf:about="https://w3id.org/bpo#RangedAttribute"/>
    


    <!-- https://w3id.org/rsdo#AA -->


    <owl:Class rdf:about="https://w3id.org/rsdo#AA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#AB -->


    <owl:Class rdf:about="https://w3id.org/rsdo#AB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#AbstractElement -->


    <owl:Class rdf:about="https://w3id.org/rsdo#AbstractElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bpo#Element"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rsdo#SolidElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Angle -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Angle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#GeometricAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Area -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Area">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#GeometricAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BA -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BB -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BallastedTrack -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BallastedTrack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Track"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rsdo#BallastlessTrack"/>
        <rdfs:comment>有无砟道床的是无砟轨道</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BallastlessTrack -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BallastlessTrack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Track"/>
        <rdfs:comment>有碎石道床的是有砟轨道</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BeamBottomToBearingStoneTopHeight -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BeamBottomToBearingStoneTopHeight">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Height"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BeamBottomToPierTopHeight -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BeamBottomToPierTopHeight">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Height"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BeamJointWidth -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BeamJointWidth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Width"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BearingQuantity -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BearingQuantity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Quantity"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BearingStoneCalculatedHeight -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BearingStoneCalculatedHeight">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Height"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BearingToJointCenterlineDistance -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BearingToJointCenterlineDistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#Distance"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Blocky -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Blocky">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RockStructuralShapeAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BlockyStructure -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BlockyStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RockStructureTypeAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BottomAndTrackFoundationLeftIntersection -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BottomAndTrackFoundationLeftIntersection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#ControlPointAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#BottomAndTrackFoundationRightIntersection -->


    <owl:Class rdf:about="https://w3id.org/rsdo#BottomAndTrackFoundationRightIntersection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#ControlPointAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Bridge -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Bridge">
