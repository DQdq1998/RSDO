    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CA -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CB -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#LiningCrossSectionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CRTSⅠDoubleBlockBallastlessTrack -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CRTSⅠDoubleBlockBallastlessTrack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#BallastlessTrack"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CRTSⅠSlabBallastlessTrack -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CRTSⅠSlabBallastlessTrack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#BallastlessTrack"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CRTSⅢSlabBallastlessTrack -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CRTSⅢSlabBallastlessTrack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#BallastlessTrack"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Capacity -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Capacity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#FunctionalAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#ChemicalAttribute -->


    <owl:Class rdf:about="https://w3id.org/rsdo#ChemicalAttribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#SharedAttribute"/>
    </owl:Class>
    


