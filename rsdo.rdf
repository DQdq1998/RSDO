    <owl:Class rdf:about="https://w3id.org/rsdo#Columnar">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RockStructuralShapeAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CombinedTunnelPortal -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CombinedTunnelPortal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#TunnelPortal"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#Complete -->


    <owl:Class rdf:about="https://w3id.org/rsdo#Complete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RockIntegrityDegreeAttribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/rsdo#CompletelyWeathered -->


    <owl:Class rdf:about="https://w3id.org/rsdo#CompletelyWeathered">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rsdo#RockWeatheringDegreeAttribute"/>
